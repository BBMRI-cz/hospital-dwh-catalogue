msgid ""
"Enter keywords you are interested in into the \"Search term\" field. The "
"catalogue will search through dataset names, descriptions and keywords."
msgstr ""
"Enter keywords you are interested in into the \"Search term\" field. The "
"catalogue will search through dataset names, descriptions and keywords."

msgid "Press the \"Search\" button (if available)."
msgstr "Press the \"Search\" button (if available)."

