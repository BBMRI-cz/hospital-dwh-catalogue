# Test Environment Configuration
# Copy this file to .env for test server deployment
# NEVER commit .env with real credentials

# Core Django Settings
DEPLOY_ENV=test
SECRET_KEY=your-secret-key-here-generate-new-one
DEBUG=True
ALLOWED_HOSTS=katalog-dwh-test.int.mou.cz,localhost,127.0.0.1

# Mock LDAP Authentication (or use real LDAP: AUTH_USE_MOCK_LDAP=False + configure LDAP variables)
AUTH_USE_MOCK_LDAP=True

# PostgreSQL Databases
POSTGRES_DB=dwhi_test
POSTGRES_USER=root
POSTGRES_PASSWORD=your-strong-password-here

AUTH_DB_NAME=hospital_dwh_auth_test
AUTH_DB_USER=root
AUTH_DB_PASSWORD=your-strong-password-here
AUTH_DB_HOST=db
AUTH_DB_PORT=5432

METADATA_DB_NAME=dwhi_test
METADATA_DB_USER=root
METADATA_DB_PASSWORD=your-strong-password-here
METADATA_DB_HOST=db
METADATA_DB_PORT=5432

FAIR_GENOMES_DB_NAME=fair_genomes_test
FAIR_GENOMES_DB_USER=root
FAIR_GENOMES_DB_PASSWORD=your-strong-password-here
FAIR_GENOMES_DB_HOST=db
FAIR_GENOMES_DB_PORT=5432

# Fair Genomes Integration (configure if testing real API)
FAIR_GENOMES_FETCH_ON_STARTUP=True
FAIR_GENOMES_SYNC_INTERVAL_HOURS=24
# FAIR_GENOMES_API_URL=https://api.example.com/graphql
# FAIR_GENOMES_API_TOKEN=your-api-token-here

# Alvao Ticketing (configure if testing real API)
ALVAO_USE_MOCK=False
# ALVAO_API_URL=https://alvao.example.com/api
# ALVAO_API_TOKEN=your-api-token-here
