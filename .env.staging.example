# Staging Environment Configuration
# Copy this file to .env for staging deployment.

# Core stack
DEPLOY_ENV=staging
SECRET_KEY=your-staging-secret-key-here
DEBUG=True
ALLOWED_HOSTS=katalog-dwh-test.int.mou.cz,localhost,127.0.0.1
SITE_URL=https://katalog-dwh-test.int.mou.cz
SERVER_NAME=katalog-dwh-test.int.mou.cz

# Bootstrap admin
DJANGO_SUPERUSER_USERNAME=app-admin
DJANGO_SUPERUSER_PASSWORD=changeme-staging
ADMIN_EMAIL=admin@katalog-dwh-test.int.mou.cz

# Runtime tuning
GUNICORN_WORKERS=2
FAIR_GENOMES_SYNC_INTERVAL_HOURS=24
HEALTH_DCAT_VERSION=release-6
GRAFANA_ADMIN_PASSWORD=admin

# Integration mode
# These defaults keep staging isolated unless you intentionally validate live integrations.
MOCK_LDAP=True
MOCK_FAIR_GENOMES=True
MOCK_ALVAO=True

# PostgreSQL databases
POSTGRES_DB=dwhi_staging
POSTGRES_USER=root
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_HOST=db
POSTGRES_PORT=5432

AUTH_DB_NAME=hospital_dwh_auth_staging
AUTH_DB_USER=root
AUTH_DB_PASSWORD=your-strong-password-here
AUTH_DB_HOST=db
AUTH_DB_PORT=5432

METADATA_DB_NAME=dwhi_staging
METADATA_DB_USER=root
METADATA_DB_PASSWORD=your-strong-password-here
METADATA_DB_HOST=db
METADATA_DB_PORT=5432

FAIR_GENOMES_DB_NAME=fair_genomes_staging
FAIR_GENOMES_DB_USER=root
FAIR_GENOMES_DB_PASSWORD=your-strong-password-here
FAIR_GENOMES_DB_HOST=db
FAIR_GENOMES_DB_PORT=5432

# LDAP
# Required when MOCK_LDAP=False.
AUTH_LDAP_SERVER_URI=
AUTH_LDAP_BIND_DN=
AUTH_LDAP_BIND_PASSWORD=
AUTH_LDAP_USER_SEARCH_BASE=
AUTH_LDAP_START_TLS=False

# FAIR Genomes
# Required when MOCK_FAIR_GENOMES=False.
FAIR_GENOMES_RDF_URL=
FAIR_GENOMES_API_URL=
FAIR_GENOMES_API_TOKEN=

# Alvao
# Required when MOCK_ALVAO=False.
ALVAO_API_URL=
ALVAO_SERVICE_ACCOUNT_USERNAME=
ALVAO_SERVICE_ACCOUNT_PASSWORD=
ALVAO_DEFAULT_SERVICE_ID=

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Security / TLS
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
