# Staging Environment Configuration
# Copy this file to .env for staging deployment
# NEVER commit .env with real credentials
# The deployed staging stack uses catalogue.settings.staging.

# Core Django Settings
DEPLOY_ENV=staging
SECRET_KEY=your-secret-key-here-generate-new-one

# Bootstrap superuser (created/updated on every container startup)
# Use a name that does NOT exist in Active Directory
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=changeme-staging
DEBUG=True
ALLOWED_HOSTS=katalog-dwh-test.int.mou.cz,localhost,127.0.0.1

# Mock Flags
# These defaults keep staging isolated from external integrations unless you are
# intentionally validating a live LDAP, FAIR Genomes, or Alvao integration.
MOCK_LDAP=True
MOCK_ALVAO=True
MOCK_FAIR_GENOMES=True

# PostgreSQL Databases
# `POSTGRES_DB` is the default Django database and the bootstrap database created by the Postgres container.
# Keep `METADATA_DB_NAME` aligned with it unless you intentionally manage the warehouse schema elsewhere.
POSTGRES_DB=dwhi_staging
POSTGRES_USER=root
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_HOST=db
POSTGRES_PORT=5432

AUTH_DB_NAME=hospital_dwh_auth_staging
AUTH_DB_USER=root
AUTH_DB_PASSWORD=your-strong-password-here
AUTH_DB_HOST=db
AUTH_DB_PORT=5432

METADATA_DB_NAME=dwhi_staging
METADATA_DB_USER=root
METADATA_DB_PASSWORD=your-strong-password-here
METADATA_DB_HOST=db
METADATA_DB_PORT=5432

FAIR_GENOMES_DB_NAME=fair_genomes_staging
FAIR_GENOMES_DB_USER=root
FAIR_GENOMES_DB_PASSWORD=your-strong-password-here
FAIR_GENOMES_DB_HOST=db
FAIR_GENOMES_DB_PORT=5432

# Fair Genomes Integration (configure if validating the real API)
FAIR_GENOMES_SYNC_INTERVAL_HOURS=24
# FAIR_GENOMES_RDF_URL=
# FAIR_GENOMES_RDF_URL can point to a different host/path than FAIR_GENOMES_API_URL.
# FAIR_GENOMES_RDF_URL must point to a DCAT/FDP metadata feed, not the generic MOLGENIS schema RDF endpoint.
# FAIR_GENOMES_API_URL=https://api.example.com/graphql
# FAIR_GENOMES_API_TOKEN=your-api-token-here

# Alvao Ticketing (set MOCK_ALVAO=True to use mock stub)
# ALVAO_API_URL=https://alvao.example.com/AlvaoRestApi/v1
# ALVAO_SERVICE_ACCOUNT_USERNAME=service-account
# ALVAO_SERVICE_ACCOUNT_PASSWORD=password
# ALVAO_DEFAULT_SERVICE_ID=109

# Health DCAT-AP submodule release to use (must match a directory in health_dcat_ap/public/releases/)
HEALTH_DCAT_VERSION=release-6

# Public base URL used for building absolute URIs in JSON-LD export
SITE_URL=https://katalog-dwh-test.int.mou.cz