@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix r5r: <http://data.europa.eu/r5r/> .
@prefix FDP: <http://fdp.example.org/api/rdf/> .

FDP:Agent a owl:Class ;
    rdfs:label "Agent" .

FDP:ContactPoint a owl:Class ;
    rdfs:label "ContactPoint" .

FDP:Catalog a owl:Class ;
    rdfs:label "Catalog" .

FDP:Dataset a owl:Class ;
    rdfs:label "Dataset" .

<http://fdp.example.org/api/rdf/ContactPoint/column/email> a owl:DatatypeProperty ;
    rdfs:label "email" ;
    rdfs:domain FDP:ContactPoint .

<http://fdp.example.org/api/rdf/Agent/column/name> a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain FDP:Agent .

<http://fdp.example.org/api/rdf/Catalog/column/name> a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain FDP:Catalog .

<http://fdp.example.org/api/rdf/Catalog/column/title> a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:domain FDP:Catalog .

<http://fdp.example.org/api/rdf/Catalog/column/description> a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:domain FDP:Catalog .

<http://fdp.example.org/api/rdf/Catalog/column/applicable_legislation> a owl:ObjectProperty ;
    rdfs:label "applicable_legislation" ;
    rdfs:domain FDP:Catalog .

<http://fdp.example.org/api/rdf/Dataset/column/name> a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain FDP:Dataset .

<http://fdp.example.org/api/rdf/Dataset/column/title> a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:domain FDP:Dataset .

<http://fdp.example.org/api/rdf/Dataset/column/description> a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:domain FDP:Dataset .

<http://fdp.example.org/api/rdf/Dataset/column/identifier> a owl:DatatypeProperty ;
    rdfs:label "identifier" ;
    rdfs:domain FDP:Dataset .

<http://fdp.example.org/api/rdf/Dataset/column/type> a owl:ObjectProperty ;
    rdfs:label "type" ;
    rdfs:domain FDP:Dataset .

<http://fdp.example.org/api/rdf/Dataset/column/theme> a owl:ObjectProperty ;
    rdfs:label "theme" ;
    rdfs:domain FDP:Dataset .

<http://fdp.example.org/api/rdf/Dataset/column/keyword> a owl:DatatypeProperty ;
    rdfs:label "keyword" ;
    rdfs:domain FDP:Dataset .

<http://fdp.example.org/api/rdf/Dataset/column/provenance> a owl:DatatypeProperty ;
    rdfs:label "provenance" ;
    rdfs:domain FDP:Dataset .

<http://fdp.example.org/api/rdf/Dataset/column/access_rights> a owl:DatatypeProperty ;
    rdfs:label "access_rights" ;
    rdfs:domain FDP:Dataset .

<http://fdp.example.org/api/rdf/Dataset/column/applicable_legislation> a owl:ObjectProperty ;
    rdfs:label "applicable_legislation" ;
    rdfs:domain FDP:Dataset .

<http://fdp.example.org/api/rdf/Dataset/column/hdab> a owl:ObjectProperty ;
    rdfs:label "hdab" ;
    rdfs:domain FDP:Dataset .

<http://fdp.example.org/api/rdf/Dataset/column/contact_point> a owl:ObjectProperty ;
    rdfs:label "contact_point" ;
    rdfs:domain FDP:Dataset .

<http://fdp.example.org/api/rdf/ContactPoint/email=contact%40example.org> a FDP:ContactPoint, qb:Observation, vcard:Kind ;
    vcard:hasEmail "contact@example.org" ;
    <http://fdp.example.org/api/rdf/ContactPoint/column/email> "contact@example.org" .

<http://fdp.example.org/api/rdf/Agent/name=Test%20HDAB%20Agency> a FDP:Agent, qb:Observation, foaf:Agent ;
    foaf:name "Test HDAB Agency" ;
    <http://fdp.example.org/api/rdf/Agent/column/name> "Test HDAB Agency" .

<http://fdp.example.org/api/rdf/Catalog/name=test-catalog> a FDP:Catalog, qb:Observation, dcat:Catalog ;
    rdfs:label "test-catalog" ;
    dcat:Catalog "test-catalog" ;
    <http://fdp.example.org/api/rdf/Catalog/column/name> "test-catalog" ;
    dcat:title "Test Catalog" ;
    <http://fdp.example.org/api/rdf/Catalog/column/title> "Test Catalog" ;
    dcat:description "A catalog for unit tests." ;
    <http://fdp.example.org/api/rdf/Catalog/column/description> "A catalog for unit tests." ;
    dcat:applicableLegislation <http://data.europa.eu/eli/reg/2022/868/oj> ;
    <http://fdp.example.org/api/rdf/Catalog/column/applicable_legislation> <http://data.europa.eu/eli/reg/2022/868/oj> .

<http://fdp.example.org/api/rdf/Dataset/name=test-dataset-good> a FDP:Dataset, qb:Observation, dcat:Dataset ;
    rdfs:label "test-dataset-good" ;
    dcat:Dataset "test-dataset-good" ;
    <http://fdp.example.org/api/rdf/Dataset/column/name> "test-dataset-good" ;
    dcat:title "Good Dataset" ;
    <http://fdp.example.org/api/rdf/Dataset/column/title> "Good Dataset" ;
    dcat:description "Has all mandatory FKs." ;
    <http://fdp.example.org/api/rdf/Dataset/column/description> "Has all mandatory FKs." ;
    dcat:identifier "http://fdp.example.org/api/rdf/Dataset/name=test-dataset-good" ;
    <http://fdp.example.org/api/rdf/Dataset/column/identifier> "http://fdp.example.org/api/rdf/Dataset/name=test-dataset-good" ;
    dcat:type <http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL> ;
    <http://fdp.example.org/api/rdf/Dataset/column/type> <http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    <http://fdp.example.org/api/rdf/Dataset/column/theme> <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dcat:keyword "genomics" ;
    <http://fdp.example.org/api/rdf/Dataset/column/keyword> "genomics" ;
    dcat:provenance "Collected for testing." ;
    <http://fdp.example.org/api/rdf/Dataset/column/provenance> "Collected for testing." ;
    dcat:accessRights "http://publications.europa.eu/resource/authority/access-right/PUBLIC" ;
    <http://fdp.example.org/api/rdf/Dataset/column/access_rights> "http://publications.europa.eu/resource/authority/access-right/PUBLIC" ;
    dcat:applicableLegislation <http://data.europa.eu/eli/reg/2022/868/oj> ;
    <http://fdp.example.org/api/rdf/Dataset/column/applicable_legislation> <http://data.europa.eu/eli/reg/2022/868/oj> ;
    <http://fdp.example.org/api/rdf/Dataset/column/hdab> <http://fdp.example.org/api/rdf/Agent/name=Test%20HDAB%20Agency> ;
    dcat:contactPoint <http://fdp.example.org/api/rdf/ContactPoint/email=contact%40example.org> ;
    <http://fdp.example.org/api/rdf/Dataset/column/contact_point> <http://fdp.example.org/api/rdf/ContactPoint/email=contact%40example.org> .

<http://fdp.example.org/api/rdf/Dataset/name=test-dataset-no-hdab> a FDP:Dataset, qb:Observation, dcat:Dataset ;
    rdfs:label "test-dataset-no-hdab" ;
    dcat:Dataset "test-dataset-no-hdab" ;
    <http://fdp.example.org/api/rdf/Dataset/column/name> "test-dataset-no-hdab" ;
    dcat:title "Dataset Missing HDAB" ;
    <http://fdp.example.org/api/rdf/Dataset/column/title> "Dataset Missing HDAB" ;
    dcat:description "Missing mandatory hdab FK." ;
    <http://fdp.example.org/api/rdf/Dataset/column/description> "Missing mandatory hdab FK." ;
    dcat:identifier "http://fdp.example.org/api/rdf/Dataset/name=test-dataset-no-hdab" ;
    <http://fdp.example.org/api/rdf/Dataset/column/identifier> "http://fdp.example.org/api/rdf/Dataset/name=test-dataset-no-hdab" ;
    dcat:type <http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL> ;
    <http://fdp.example.org/api/rdf/Dataset/column/type> <http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    <http://fdp.example.org/api/rdf/Dataset/column/theme> <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dcat:keyword "genomics" ;
    <http://fdp.example.org/api/rdf/Dataset/column/keyword> "genomics" ;
    dcat:provenance "Collected for testing." ;
    <http://fdp.example.org/api/rdf/Dataset/column/provenance> "Collected for testing." ;
    dcat:accessRights "http://publications.europa.eu/resource/authority/access-right/PUBLIC" ;
    <http://fdp.example.org/api/rdf/Dataset/column/access_rights> "http://publications.europa.eu/resource/authority/access-right/PUBLIC" ;
    dcat:applicableLegislation <http://data.europa.eu/eli/reg/2022/868/oj> ;
    <http://fdp.example.org/api/rdf/Dataset/column/applicable_legislation> <http://data.europa.eu/eli/reg/2022/868/oj> ;
    dcat:contactPoint <http://fdp.example.org/api/rdf/ContactPoint/email=contact%40example.org> ;
    <http://fdp.example.org/api/rdf/Dataset/column/contact_point> <http://fdp.example.org/api/rdf/ContactPoint/email=contact%40example.org> .
