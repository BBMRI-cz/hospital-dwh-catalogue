@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix r5r:  <http://data.europa.eu/r5r/> .
@prefix hdcat: <https://healthdataportal.eu/ns/health#> .

# ContactPoint
<http://fdp.example.org/ContactPoint/cp1>
    a vcard:Kind ;
    vcard:hasEmail "contact@example.org" .

# Agent
<http://fdp.example.org/Agent/ag1>
    a foaf:Agent ;
    foaf:name "Test HDAB Agency" .

# Catalog
<http://fdp.example.org/Catalog/cat1>
    a dcat:Catalog ;
    rdfs:label "test-catalog" ;
    dct:title "Test Catalog" ;
    dct:description "A catalog for unit tests." ;
    r5r:applicableLegislation <http://data.europa.eu/eli/reg/2022/868/oj> .

# Dataset with valid FKs — should be saved
<http://fdp.example.org/Dataset/ds-good>
    a dcat:Dataset ;
    rdfs:label "test-dataset-good" ;
    dct:title "Good Dataset" ;
    dct:description "Has all mandatory FKs." ;
    dct:identifier "http://fdp.example.org/Dataset/ds-good" ;
    dct:type <http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dcat:keyword "genomics" ;
    dct:provenance "Collected for testing." ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    r5r:applicableLegislation <http://data.europa.eu/eli/reg/2022/868/oj> ;
    hdcat:healthCategory <https://healthdataportal.eu/categorisation/Health-care-delivery> ;
    dcat:contactPoint <http://fdp.example.org/ContactPoint/cp1> ;
    <http://fdp.example.org/Dataset/column/hdab> "Test HDAB Agency" .

# Dataset with MISSING hdab — should be skipped
<http://fdp.example.org/Dataset/ds-no-hdab>
    a dcat:Dataset ;
    rdfs:label "test-dataset-no-hdab" ;
    dct:title "Dataset Missing HDAB" ;
    dct:description "Missing mandatory hdab FK." ;
    dct:identifier "http://fdp.example.org/Dataset/ds-no-hdab" ;
    dct:type <http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dcat:keyword "genomics" ;
    dct:provenance "Collected for testing." ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    r5r:applicableLegislation <http://data.europa.eu/eli/reg/2022/868/oj> ;
    hdcat:healthCategory <https://healthdataportal.eu/categorisation/Health-care-delivery> ;
    dcat:contactPoint <http://fdp.example.org/ContactPoint/cp1> .
    # intentionally no hdab predicate
