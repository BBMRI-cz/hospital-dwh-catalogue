# Development Environment Configuration
# Copy this file to .env for local development.
# CI is the only environment that stays SQLite-only.

# Core stack
DEPLOY_ENV=dev
SECRET_KEY=django-insecure-dev-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
SITE_URL=http://localhost
SERVER_NAME=localhost

# Bootstrap admin
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin

# Runtime tuning
DEPLOY_HEALTH_TIMEOUT_SECONDS=180
FAIR_GENOMES_SYNC_INTERVAL_HOURS=24
HEALTH_DCAT_VERSION=release-6
CATALOGUE_PAGE_SIZE=15

# Integration mode
# Development stays fully mocked on purpose, so no live integration
# credentials are needed in this template.
MOCK_LDAP=True
MOCK_FAIR_GENOMES=True
MOCK_ALVAO=True
ALVAO_TEST_REQUESTER_EMAIL=
ALVAO_TEST_REQUESTER_NAME=

# PostgreSQL databases
POSTGRES_DB=dwhi_dev
POSTGRES_USER=root
POSTGRES_PASSWORD=dwh_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

AUTH_DB_NAME=hospital_dwh_auth
AUTH_DB_USER=root
AUTH_DB_PASSWORD=dwh_password
AUTH_DB_HOST=db
AUTH_DB_PORT=5432

METADATA_DB_NAME=dwhi_dev
METADATA_DB_USER=root
METADATA_DB_PASSWORD=dwh_password
METADATA_DB_HOST=db
METADATA_DB_PORT=5432

FAIR_GENOMES_DB_NAME=fair_genomes
FAIR_GENOMES_DB_USER=root
FAIR_GENOMES_DB_PASSWORD=dwh_password
FAIR_GENOMES_DB_HOST=db
FAIR_GENOMES_DB_PORT=5432
