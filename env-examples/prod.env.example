# Production Environment Configuration
# Copy this file to .env for production deployment.
# Replace every placeholder before running ./deploy.sh.

# Core stack
DEPLOY_ENV=prod
SECRET_KEY=your-very-strong-secret-key-here
ALLOWED_HOSTS=katalog-dwh.int.mou.cz,localhost,127.0.0.1
SITE_URL=https://katalog-dwh.int.mou.cz
SERVER_NAME=katalog-dwh.int.mou.cz
# Relative to the repository root.
NGINX_SSL_CERT_PATH=certs/server.crt
NGINX_SSL_KEY_PATH=certs/server.key

# Bootstrap admin
# Use a username that does not exist in Active Directory.
DJANGO_SUPERUSER_USERNAME=app-admin
DJANGO_SUPERUSER_PASSWORD=your-strong-superuser-password-here
ADMIN_EMAIL=admin@mou.cz

# Runtime tuning
GUNICORN_WORKERS=4
FAIR_GENOMES_SYNC_INTERVAL_HOURS=24
HEALTH_DCAT_VERSION=release-6

# PostgreSQL databases
POSTGRES_DB=hospital_dwh_prod
POSTGRES_USER=root
POSTGRES_PASSWORD=your-very-strong-password-here
POSTGRES_HOST=db
POSTGRES_PORT=5432

AUTH_DB_NAME=hospital_dwh_auth_prod
AUTH_DB_USER=root
AUTH_DB_PASSWORD=your-very-strong-password-here
AUTH_DB_HOST=db
AUTH_DB_PORT=5432

METADATA_DB_NAME=hospital_dwh_prod
METADATA_DB_USER=root
METADATA_DB_PASSWORD=your-very-strong-password-here
METADATA_DB_HOST=db
METADATA_DB_PORT=5432

FAIR_GENOMES_DB_NAME=fair_genomes_prod
FAIR_GENOMES_DB_USER=root
FAIR_GENOMES_DB_PASSWORD=your-very-strong-password-here
FAIR_GENOMES_DB_HOST=db
FAIR_GENOMES_DB_PORT=5432

# LDAP
AUTH_LDAP_SERVER_URI=ldaps://your-dc-server.example.com:636
AUTH_LDAP_BIND_DN=cn=service-account,ou=ServiceAccounts,dc=example,dc=com
AUTH_LDAP_BIND_PASSWORD=your-service-account-password
AUTH_LDAP_USER_SEARCH_BASE=ou=Users,dc=example,dc=com
AUTH_LDAP_LOGIN_ATTR=sAMAccountName
AUTH_LDAP_START_TLS=False
AUTH_LDAP_CA_CERT_PATH=certs/ldap-ca.crt

# FAIR Genomes
FAIR_GENOMES_RDF_URL=https://production-fdp.example.com
FAIR_GENOMES_API_URL=https://production-api.example.com/graphql
FAIR_GENOMES_API_TOKEN=your-production-api-token-here

# Alvao
ALVAO_API_URL=https://alvao.company.com/AlvaoRestApi/v1
ALVAO_SERVICE_ACCOUNT_USERNAME=your-service-account
ALVAO_SERVICE_ACCOUNT_PASSWORD=your-service-account-password
ALVAO_DEFAULT_SERVICE_ID=109

# Email
EMAIL_HOST=smtp.company.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@company.com
EMAIL_HOST_PASSWORD=your-email-password

# Security / TLS
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
