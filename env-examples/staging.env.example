# Staging Environment Configuration
# Copy this file to .env for staging deployment.

# Core stack
DEPLOY_ENV=staging
SECRET_KEY=your-staging-secret-key-here
DEBUG=True
ALLOWED_HOSTS=katalog-dwh-test.int.mou.cz,localhost,127.0.0.1
SITE_URL=https://katalog-dwh-test.int.mou.cz
SERVER_NAME=katalog-dwh-test.int.mou.cz

# Bootstrap admin
DJANGO_SUPERUSER_USERNAME=app-admin
DJANGO_SUPERUSER_PASSWORD=changeme-staging

# Runtime tuning
GUNICORN_WORKERS=2
FAIR_GENOMES_SYNC_INTERVAL_HOURS=24
HEALTH_DCAT_VERSION=release-6

# Integration mode
# Staging keeps LDAP mocked by default, but uses live-like FAIR Genomes and
# Alvao placeholders so it is closer to production.
MOCK_LDAP=True
MOCK_FAIR_GENOMES=False
MOCK_ALVAO=False

# PostgreSQL databases
POSTGRES_DB=dwhi_staging
POSTGRES_USER=root
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_HOST=db
POSTGRES_PORT=5432

AUTH_DB_NAME=hospital_dwh_auth_staging
AUTH_DB_USER=root
AUTH_DB_PASSWORD=your-strong-password-here
AUTH_DB_HOST=db
AUTH_DB_PORT=5432

METADATA_DB_NAME=dwhi_staging
METADATA_DB_USER=root
METADATA_DB_PASSWORD=your-strong-password-here
METADATA_DB_HOST=db
METADATA_DB_PORT=5432

FAIR_GENOMES_DB_NAME=fair_genomes_staging
FAIR_GENOMES_DB_USER=root
FAIR_GENOMES_DB_PASSWORD=your-strong-password-here
FAIR_GENOMES_DB_HOST=db
FAIR_GENOMES_DB_PORT=5432

# FAIR Genomes
FAIR_GENOMES_RDF_URL=https://staging-fdp.example.com
FAIR_GENOMES_API_URL=https://staging-api.example.com/graphql
FAIR_GENOMES_API_TOKEN=your-staging-api-token-here

# Alvao
ALVAO_API_URL=https://test-alvao.company.com/AlvaoRestApi/v1
ALVAO_SERVICE_ACCOUNT_USERNAME=your-staging-service-account
ALVAO_SERVICE_ACCOUNT_PASSWORD=your-staging-service-account-password
ALVAO_DEFAULT_SERVICE_ID=109
