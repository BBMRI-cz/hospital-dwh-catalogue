# Development Environment Configuration
# Copy this file to .env for local development
# NEVER commit .env with real credentials

# Core Django Settings
DEPLOY_ENV=dev
SECRET_KEY=django-insecure-dev-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Mock Flags
MOCK_LDAP=True
MOCK_FAIR_GENOMES=True
MOCK_ALVAO=True

# PostgreSQL Databases (all use same credentials for dev simplicity)
POSTGRES_DB=dwhi_test
POSTGRES_USER=root
POSTGRES_PASSWORD=dwh_password

AUTH_DB_NAME=hospital_dwh_auth
AUTH_DB_USER=root
AUTH_DB_PASSWORD=dwh_password
AUTH_DB_HOST=db
AUTH_DB_PORT=5432

METADATA_DB_NAME=dwhi_test
METADATA_DB_USER=root
METADATA_DB_PASSWORD=dwh_password
METADATA_DB_HOST=db
METADATA_DB_PORT=5432

FAIR_GENOMES_DB_NAME=fair_genomes
FAIR_GENOMES_DB_USER=root
FAIR_GENOMES_DB_PASSWORD=dwh_password
FAIR_GENOMES_DB_HOST=db
FAIR_GENOMES_DB_PORT=5432

# Fair Genomes Integration (set MOCK_FAIR_GENOMES=True above to seed sample data instead)
FAIR_GENOMES_FETCH_ON_STARTUP=False
FAIR_GENOMES_SYNC_INTERVAL_HOURS=24
# FAIR_GENOMES_RDF_URL=
# FAIR_GENOMES_API_URL=https://api.example.com/graphql
# FAIR_GENOMES_API_TOKEN=your-token-here

# Alvao Ticketing (mock enabled, uncomment to test real API)
# ALVAO_API_URL=https://alvao.example.com/AlvaoRestApi/v1
# ALVAO_SERVICE_ACCOUNT_USERNAME=service-account
# ALVAO_SERVICE_ACCOUNT_PASSWORD=password
# ALVAO_DEFAULT_SERVICE_ID=109

# Health DCAT-AP submodule release to use (must match a directory in health_dcat_ap/public/releases/)
HEALTH_DCAT_VERSION=release-6

# Public base URL used for building absolute URIs in JSON-LD export
SITE_URL=http://localhost:8000
