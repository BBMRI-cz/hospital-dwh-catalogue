# Development Environment Configuration
# This file is for local development only
# NEVER commit this file with real credentials
# Copy this file to .env and adjust values as needed

# Deployment Environment
DEPLOY_ENV=dev

# Django Core Settings
SECRET_KEY=django-insecure-dev-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL Database Configuration (for docker compose)
POSTGRES_DB=dwhi_test
POSTGRES_USER=root
POSTGRES_PASSWORD=dwh_password

# Authentication Database (Users, Groups, Permissions, Sessions)
AUTH_DB_ENGINE=django.db.backends.postgresql
AUTH_DB_NAME=hospital_dwh_auth
AUTH_DB_USER=root
AUTH_DB_PASSWORD=dwh_password
AUTH_DB_HOST=db
AUTH_DB_PORT=5432

# Django Database Configuration (Warehouse Metadata)
METADATA_DB_ENGINE=django.db.backends.postgresql
METADATA_DB_NAME=dwhi_test
METADATA_DB_USER=root
METADATA_DB_PASSWORD=dwh_password
METADATA_DB_HOST=db
METADATA_DB_PORT=5432

# Fair Genomes Database (Separate Database)
FAIR_GENOMES_DB_ENGINE=django.db.backends.postgresql
FAIR_GENOMES_DB_NAME=fair_genomes
FAIR_GENOMES_DB_USER=root
FAIR_GENOMES_DB_PASSWORD=dwh_password
FAIR_GENOMES_DB_HOST=db
FAIR_GENOMES_DB_PORT=5432

# Fair Genomes GraphQL API
FAIR_GENOMES_API_URL=address-of-fair-genomes-graphql-api
FAIR_GENOMES_API_TOKEN=your-api-token-here

# Fair Genomes Sync Configuration
FAIR_GENOMES_FETCH_ON_STARTUP=True
FAIR_GENOMES_SYNC_INTERVAL_HOURS=24

# Alvao Service Desk Configuration - For development
ALVAO_USE_MOCK=True

# Real Alvao API settings (used when ALVAO_USE_MOCK=False)
ALVAO_API_URL=address-of-alvao-api
# Bearer token for API authentication
ALVAO_API_TOKEN=your-api-token-here

# Alternative: Basic authentication (if token not available)
ALVAO_SERVICE_ACCOUNT_USERNAME=alvao-username
ALVAO_SERVICE_ACCOUNT_PASSWORD=alvao-password

# Default service ID for new tickets (optional, get from Alvao admin)
ALVAO_DEFAULT_SERVICE_ID=service-id
