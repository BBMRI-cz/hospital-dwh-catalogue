# Development Environment Configuration
# Copy this file to .env for local development.
# CI is the only environment that stays SQLite-only.

# Core stack
DEPLOY_ENV=dev
SECRET_KEY=django-insecure-dev-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
SITE_URL=http://localhost
SERVER_NAME=localhost

# Bootstrap admin
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
ADMIN_EMAIL=admin@localhost

# Runtime tuning
GUNICORN_WORKERS=2
FAIR_GENOMES_SYNC_INTERVAL_HOURS=24
HEALTH_DCAT_VERSION=release-6
GRAFANA_ADMIN_PASSWORD=admin

# Integration mode
MOCK_LDAP=True
MOCK_FAIR_GENOMES=True
MOCK_ALVAO=True

# PostgreSQL databases
POSTGRES_DB=dwhi_dev
POSTGRES_USER=root
POSTGRES_PASSWORD=dwh_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

AUTH_DB_NAME=hospital_dwh_auth
AUTH_DB_USER=root
AUTH_DB_PASSWORD=dwh_password
AUTH_DB_HOST=db
AUTH_DB_PORT=5432

METADATA_DB_NAME=dwhi_dev
METADATA_DB_USER=root
METADATA_DB_PASSWORD=dwh_password
METADATA_DB_HOST=db
METADATA_DB_PORT=5432

FAIR_GENOMES_DB_NAME=fair_genomes
FAIR_GENOMES_DB_USER=root
FAIR_GENOMES_DB_PASSWORD=dwh_password
FAIR_GENOMES_DB_HOST=db
FAIR_GENOMES_DB_PORT=5432

# LDAP
# Only required when MOCK_LDAP=False.
AUTH_LDAP_SERVER_URI=
AUTH_LDAP_BIND_DN=
AUTH_LDAP_BIND_PASSWORD=
AUTH_LDAP_USER_SEARCH_BASE=
AUTH_LDAP_START_TLS=False

# FAIR Genomes
# Leave blank while MOCK_FAIR_GENOMES=True.
FAIR_GENOMES_RDF_URL=
FAIR_GENOMES_API_URL=
FAIR_GENOMES_API_TOKEN=

# Alvao
# Leave blank while MOCK_ALVAO=True.
ALVAO_API_URL=
ALVAO_SERVICE_ACCOUNT_USERNAME=
ALVAO_SERVICE_ACCOUNT_PASSWORD=
ALVAO_DEFAULT_SERVICE_ID=

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Security / TLS
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
