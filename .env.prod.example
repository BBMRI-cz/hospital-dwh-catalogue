# Production Environment Configuration
# This file is for production deployment
# NEVER commit this file - keep it secure and secret
# Copy this file to .env and adjust values as needed

# Deployment Environment
DEPLOY_ENV=prod

# Django Core Settings
SECRET_KEY=your-very-strong-secret-key-here-generate-with-django
DEBUG=False
ALLOWED_HOSTS=your-production-domain.com,www.your-production-domain.com

# PostgreSQL Database Configuration
POSTGRES_DB=hospital_dwh_prod
POSTGRES_USER=root
POSTGRES_PASSWORD=your-very-strong-password-here

# Authentication Database (Users, Groups, Permissions, Sessions)
AUTH_DB_ENGINE=django.db.backends.postgresql
AUTH_DB_NAME=hospital_dwh_auth_prod
AUTH_DB_USER=root
AUTH_DB_PASSWORD=your-very-strong-password-here
AUTH_DB_HOST=db
AUTH_DB_PORT=5432

# PostgreSQL Database Configuration (Warehouse Metadata)
METADATA_DB_ENGINE=django.db.backends.postgresql
METADATA_DB_NAME=hospital_dwh_prod
METADATA_DB_USER=root
METADATA_DB_PASSWORD=your-very-strong-password-here
METADATA_DB_HOST=db
METADATA_DB_PORT=5432

# Fair Genomes Database (Separate Database)
FAIR_GENOMES_DB_ENGINE=django.db.backends.postgresql
FAIR_GENOMES_DB_NAME=fair_genomes_prod
FAIR_GENOMES_DB_USER=root
FAIR_GENOMES_DB_PASSWORD=your-very-strong-password-here
FAIR_GENOMES_DB_HOST=db
FAIR_GENOMES_DB_PORT=5432

# Fair Genomes GraphQL API
FAIR_GENOMES_API_URL=address-of-production-fair-genomes-graphql-api
FAIR_GENOMES_API_TOKEN=your-production-api-token-here

# Fair Genomes Sync Configuration
FAIR_GENOMES_FETCH_ON_STARTUP=True
FAIR_GENOMES_SYNC_INTERVAL_HOURS=24

# Alvao Service Desk Configuration - For development
ALVAO_USE_MOCK=False

# Real Alvao API settings (used when ALVAO_USE_MOCK=False)
ALVAO_API_URL=address-of-alvao-api
# Bearer token for API authentication
ALVAO_API_TOKEN=your-api-token-here

# Alternative: Basic authentication (if token not available)
ALVAO_SERVICE_ACCOUNT_USERNAME=alvao-username
ALVAO_SERVICE_ACCOUNT_PASSWORD=alvao-password

# Default service ID for new tickets (optional, get from Alvao admin)
ALVAO_DEFAULT_SERVICE_ID=

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Gunicorn Configuration
GUNICORN_WORKERS=4

# Email Configuration (for error notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
ADMIN_EMAIL=admin@your-production-domain.com
